# PostgreSQL (Prisma). `bun run db:start` lance le conteneur Docker sur le port 5433.
DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/local"

# Base dédiée aux tests Vitest (vidée à chaque test), créée au besoin par la suite de tests.
DATABASE_URL_TEST="postgres://root:mysecretpassword@localhost:5433/poj_test"

# Bac à sable manuel (`bun run sandbox`), recréé avec la seed par `bun run sandbox:reset`.
DATABASE_URL_SANDBOX="postgres://root:mysecretpassword@localhost:5433/poj_sandbox"

# Origine de l'app, ex. http://localhost:5173
ORIGIN="http://localhost:5173"

# Better Auth : 32+ caractères aléatoires (ex. `openssl rand -base64 32`)
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# DeepL (facultatif) : second avis de traduction. Clé gratuite sur https://www.deepl.com/pro-api
# (elle se termine par `:fx`). Sans clé, les suggestions DeepL sont désactivées.
DEEPL_API_KEY=""
