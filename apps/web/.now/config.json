{
	"model": "haiku",
	"check": "bun run check",
	"routesDir": "src/routes",
	"deny": [
		"src/lib/server/**",
		"**/*.server.ts",
		"**/*.server.js",
		"**/+server.ts",
		"**/+server.js",
		"**/*.remote.ts",
		"**/*.remote.js",
		"src/hooks*.*",
		"prisma/**",
		"*.config.*",
		"package.json",
		".env*",
		".now/**",
		"src/env.ts",
		"src/service-worker/**",
		"**/*.spec.ts",
		"**/*.test.ts",
		"e2e/**",
		"scripts/**",
		"vitest.global-setup.ts"
	],
	"read": ["DESIGN.md", "PRODUCT.md"],
	"allowRemote": false
}
