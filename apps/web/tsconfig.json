{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true,
		"noUncheckedIndexedAccess": true
	},
	"include": [
		"src",
		"scripts",
		"e2e",
		"prisma.config.ts",
		"playwright.config.ts",
		"vitest.global-setup.ts"
	],
	"exclude": ["src/service-worker"]
}
