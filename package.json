{
	"name": "poj",
	"private": true,
	"type": "module",
	"workspaces": ["apps/web"],
	"scripts": {
		"dev": "bun --filter @poj/web dev",
		"build": "bun --filter @poj/web build",
		"check": "bun --filter @poj/web check",
		"lint": "bun --filter @poj/web lint",
		"test": "bun --filter @poj/web test:unit --run",
		"db:start": "docker compose up -d",
		"db:migrate": "bun --filter @poj/web db:migrate",
		"stack:up": "BUILD_COMMIT=$(git rev-parse --short HEAD) docker compose --profile prod up -d --build",
		"stack:stop": "docker compose stop app proxy",
		"sandbox": "bun --filter @poj/web sandbox",
		"sandbox:reset": "bun --filter @poj/web sandbox:reset",
		"sandbox:seed": "bun --filter @poj/web sandbox:seed",
		"api:export": "bun --filter @poj/web api:export",
		"api:check": "bun --filter @poj/web api:check",
		"ios:project": "cd apps/ios && xcodegen generate",
		"ios:build": "xcodebuild -project apps/ios/Poj.xcodeproj -scheme Poj -destination 'generic/platform=iOS Simulator' -derivedDataPath apps/ios/.build/DerivedData -skipPackagePluginValidation build",
		"ios:test": "cd apps/ios/Packages/PojAPI && swift test"
	}
}
